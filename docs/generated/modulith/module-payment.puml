@startuml
title <size:24>Payment</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("Modules_boundary", "Modules", $tags="") {
  Container_Boundary("Modules.Modules_boundary", "Modules", $tags="") {
    Component(Modules.Modules.Platform, "Platform", $techn="Module", $descr="", $tags="", $link="")
    Component(Modules.Modules.Contracts, "Contracts", $techn="Module", $descr="", $tags="", $link="")
    Component(Modules.Modules.Payment, "Payment", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(Modules.Modules.Payment, Modules.Modules.Contracts, "depends on", $techn="", $tags="", $link="")
Rel(Modules.Modules.Payment, Modules.Modules.Platform, "uses", $techn="", $tags="", $link="")
Rel(Modules.Modules.Contracts, Modules.Modules.Platform, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml